<script>
    document.addEventListener('DOMContentLoaded', function() {
        var add_modal_el = document.getElementById('polarismail-add-modal');
        var edit_modal_el = document.getElementById('polarismail-edit-modal');
        var import_modal_el = document.getElementById('polarismail-import-modal');
        var action_form = document.getElementById('polarismail-account-action-form');
        var password_field = document.getElementById('polarismail-add-password');
        var password_feedback = document.getElementById('polarismail-password-feedback');
        var delete_confirm = <?php echo json_encode(Language::_('Polarismail.tab_client_accounts.confirm_delete', true)); ?>;

        function showModal(modal_el) {
            if (modal_el) {
                bootstrap.Modal.getOrCreateInstance(modal_el).show();
            }
        }

        // Password validation function
        function validatePassword(password) {
            if (password.length < 8) return false;
            if (!/[A-Z]/.test(password)) return false;
            if (!/[0-9]/.test(password)) return false;
            if (!/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)) return false;
            return true;
        }

        // Generate secure password
        function generateSecurePassword() {
            var length = 12;
            var uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            var lowercase = 'abcdefghijklmnopqrstuvwxyz';
            var numbers = '0123456789';
            var symbols = '!@#$%^&*()_+-=[]{};\':"|,.<>/?';
            var all = uppercase + lowercase + numbers + symbols;
            var password = '';

            // Ensure at least one of each required character type
            password += uppercase.charAt(Math.floor(Math.random() * uppercase.length));
            password += numbers.charAt(Math.floor(Math.random() * numbers.length));
            password += symbols.charAt(Math.floor(Math.random() * symbols.length));

            // Fill the rest randomly
            for (var i = password.length; i < length; i++) {
                password += all.charAt(Math.floor(Math.random() * all.length));
            }

            // Shuffle the password
            password = password.split('').sort(function(){return 0.5-Math.random()}).join('');

            return password;
        }

        // Generate password button click handler
        var generate_button = document.getElementById('polarismail-generate-password');
        if (generate_button) {
            generate_button.addEventListener('click', function(event) {
                event.preventDefault();
                var password = generateSecurePassword();
                password_field.value = password;
                password_field.type = 'text';

                var toggle_icon = document.querySelector('#polarismail-toggle-password i');
                if (toggle_icon) {
                    toggle_icon.classList.remove('bi-eye');
                    toggle_icon.classList.add('bi-eye-slash');
                }

                // Validate the generated password
                if (validatePassword(password)) {
                    password_field.classList.remove('is-invalid');
                    password_field.classList.add('is-valid');
                    password_feedback.style.display = 'none';
                }
            });
        }

        // Toggle password visibility
        var toggle_button = document.getElementById('polarismail-toggle-password');
        if (toggle_button) {
            toggle_button.addEventListener('click', function(event) {
                event.preventDefault();
                var icon = this.querySelector('i');

                if (password_field.type === 'password') {
                    password_field.type = 'text';
                    if (icon) {
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    }
                } else {
                    password_field.type = 'password';
                    if (icon) {
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    }
                }
            });
        }

        // Password validation on input
        if (password_field) {
            password_field.addEventListener('input', function() {
                var password = this.value;
                if (password.length === 0) {
                    this.classList.remove('is-invalid', 'is-valid');
                    password_feedback.style.display = 'none';
                    return;
                }

                if (validatePassword(password)) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                    password_feedback.style.display = 'none';
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                    password_feedback.style.display = 'block';
                }
            });
        }

        // Form validation on submit
        var add_form = document.getElementById('polarismail-add-form');
        if (add_form) {
            add_form.addEventListener('submit', function(event) {
                if (!validatePassword(password_field.value)) {
                    event.preventDefault();
                    password_field.classList.add('is-invalid');
                    password_feedback.style.display = 'block';
                }
            });
        }

        var add_button = document.getElementById('polarismail-add-account-button');
        if (add_button) {
            add_button.addEventListener('click', function(event) {
                event.preventDefault();
                showModal(add_modal_el);
            });
        }

        var import_button = document.getElementById('polarismail-import-account-button');
        if (import_button) {
            import_button.addEventListener('click', function(event) {
                event.preventDefault();
                showModal(import_modal_el);
            });
        }

        document.querySelectorAll('.edit-account').forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                var row = this.closest('tr');
                if (!row || !edit_modal_el) {
                    return;
                }

                edit_modal_el.querySelector('input[name="account_username"]').value = row.getAttribute('data-account-username');
                edit_modal_el.querySelector('input[name="account_email"]').value = row.getAttribute('data-account-email');
                edit_modal_el.querySelector('select[name="account_type"]').value = row.getAttribute('data-account-type');
                edit_modal_el.querySelector('input[name="quota"]').value = row.getAttribute('data-account-quota');
                edit_modal_el.querySelector('input[name="display_name"]').value = row.getAttribute('data-account-name');
                edit_modal_el.querySelector('input[name="password"]').value = '';

                showModal(edit_modal_el);
            });
        });

        document.querySelectorAll('.account-action-trigger').forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                var action = this.getAttribute('data-action');
                var username = this.getAttribute('data-username');

                if (!action || !username) {
                    return;
                }

                if (action === 'delete' && !confirm(delete_confirm)) {
                    return;
                }

                action_form.querySelector('input[name="account_action"]').value = action;
                action_form.querySelector('input[name="account_username"]').value = username;
                action_form.submit();
            });
        });

        <?php if ($show_add_modal_flag) { ?>
        showModal(add_modal_el);
        <?php } ?>

        <?php if ($show_edit_modal_flag) { ?>
        showModal(edit_modal_el);
        <?php } ?>

        // Toggle +/- icon for CSV instructions collapse
        var csv_collapse = document.getElementById('csv-instructions-collapse');
        var csv_icon = document.getElementById('csv-instructions-icon');
        if (csv_collapse && csv_icon) {
            csv_collapse.addEventListener('show.bs.collapse', function() {
                csv_icon.classList.remove('bi-plus-circle');
                csv_icon.classList.add('bi-dash-circle');
            });
            csv_collapse.addEventListener('hide.bs.collapse', function() {
                csv_icon.classList.remove('bi-dash-circle');
                csv_icon.classList.add('bi-plus-circle');
            });
        }
    });
</script>
<?php } ?>
