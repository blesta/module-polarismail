                <i class="bi bi-shield-lock me-2"></i>
                <?php $this->_('Polarismail.tab_client_dkim.heading'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-end">
                <?php $this->_('Polarismail.tab_client_dkim.verification_intro'); ?>
            </span>
        </div>
        <div class="card-body polarismail-alert-spaced">
            <?php if (!empty($notice) && !empty($notice['message'])) { ?>
            <div class="alert alert-<?php echo $notice['type'] === 'success' ? 'success' : ($notice['type'] === 'warning' ? 'warning' : 'danger'); ?>">
                <?php echo $this->Html->safe($notice['message']); ?>
