                                        <a href="#" class="dropdown-item text-danger account-action-trigger" data-action="delete" data-username="<?php echo $this->Html->safe($username_value); ?>">
                                            <i class="bi bi-trash"></i> <?php $this->_('Polarismail.tab_client_accounts.option_delete'); ?>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
