<?php
include __DIR__ . DS . 'partials' . DS . 'client_styles.pdt';

$verification_required_flag = !empty($verification_required);
$pending_label = $this->_('Polarismail.verification_pending_action.lists', true);
$pending_url = isset($pending_manage_uri) ? $pending_manage_uri : '';
$pending_target = $this->Html->safe($pending_label);
if (!empty($pending_url)) {
    $pending_target = '<a href="' . $this->Html->safe($pending_url) . '"'
        . ' class="polarismail-cta-link">'
        . $this->Html->safe($pending_label)
        . '</a>';
}
$pending_message = sprintf(
    $this->_('Polarismail.verification_pending_action', true),
    $pending_target
);

$lists_collection = [];
if (isset($lists) && is_array($lists)) {
    $lists_collection = $lists;
}

$accounts_list = [];
if (isset($accounts) && is_array($accounts)) {
    $accounts_list = $accounts;
}

$service_domain_name = isset($service_domain) ? $service_domain : '';
$list_limit_value = isset($list_limit) ? (int) $list_limit : 0;
$list_count = count($lists_collection);
$limit_reached = $list_limit_value > 0 && $list_count >= $list_limit_value;
$add_values = isset($add_values) && is_array($add_values) ? $add_values : [];
$edit_values = isset($edit_values) && is_array($edit_values) ? $edit_values : [];
$edit_list_name = isset($edit_list_name) ? $edit_list_name : '';
$edit_members = isset($edit_members) && is_array($edit_members) ? $edit_members : [];
$list_members = isset($list_members) && is_array($list_members) ? $list_members : [];

$get_value = function ($array, $key, $default = '') {
    return isset($array[$key]) ? $array[$key] : $default;
};


$account_emails = [];
foreach ($accounts_list as $account) {
    if (isset($account->email) && $account->email !== '') {
        $account_emails[] = $account->email;
    } elseif (isset($account->username) && $account->username !== '' && $service_domain_name !== '') {
        $account_emails[] = $account->username . '@' . $service_domain_name;
    }
}
$account_emails = array_unique($account_emails);
?>
<div class="polarismail-client-container polarismail-lists">
    <?php if ($verification_required_flag) { ?>
    <div class="card polarismail-card polarismail-card-locked">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="fas fa-lock mr-2"></i>
                <?php $this->_('Polarismail.tab_client_lists.card_manage_title'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-right">
                <?php $this->_('Polarismail.tab_client_lists.description'); ?>
            </span>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <?php echo $pending_message; ?>
            </div>
        </div>
    </div>
    <?php } else { ?>
    <div class="card polarismail-card">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="fas fa-list-ul mr-2"></i>
                <?php $this->_('Polarismail.tab_client_lists.card_manage_title'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-right">
                <?php $this->_('Polarismail.tab_client_lists.description'); ?>
            </span>
        </div>
        <div class="card-body polarismail-alert-spaced">
            <div class="alert alert-info">
                <?php $this->_('Polarismail.tab_client_lists.description_manage'); ?>
            </div>
        </div>
    </div>

    

    

    <div class="card polarismail-card">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="fas fa-plus-circle mr-2"></i>
                <?php $this->_('Polarismail.tab_client_lists.heading_add'); ?>
            </h4>
        </div>
        <div class="card-body">
            <?php if ($limit_reached) { ?>
                <div class="alert alert-danger mb-0">
                    <?php $this->_('Polarismail.tab_client_lists.list_limit'); ?>
                </div>
            <?php } elseif (empty($account_emails)) { ?>
                <div class="alert alert-warning mb-0">
                    <?php $this->_('Polarismail.tab_client_lists.error_no_accounts'); ?>
                </div>
            <?php } else { ?>
                <?php $this->Form->create(null, ['id' => 'polarismail-list-add-form']); ?>
                <?php $this->Form->fieldHidden('list_action', 'add'); ?>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="polarismail-list-name"><?php $this->_('Polarismail.tab_client_lists.field_list_name'); ?></label>
                        <div class="input-group">
                            <input
                                type="text"
                                class="form-control"
                                id="polarismail-list-name"
                                name="lname"
                                value="<?php echo $this->Html->safe($get_value($add_values, 'lname')); ?>"
                                placeholder="list-name"
                                required
                            >
                            <div class="input-group-append">
                                <span class="input-group-text">@<?php echo $this->Html->safe($service_domain_name); ?></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="polarismail-list-type"><?php $this->_('Polarismail.tab_client_lists.field_list_type'); ?></label>
                        <select class="form-control" id="polarismail-list-type" name="ltype">
                            <option value="1" selected><?php echo $this->Html->safe($this->_('Polarismail.tab_client_lists.list_type_distribution', true)); ?></option>
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="polarismail-list-members"><?php $this->_('Polarismail.tab_client_lists.field_members'); ?></label>
                        <select class="form-control" id="polarismail-list-members" name="members[]" multiple>
                            <?php foreach ($account_emails as $email) {
                                $selected = in_array($email, $get_value($add_values, 'members', []), true) ? 'selected' : '';
                            ?>
                            <option value="<?php echo $this->Html->safe($email); ?>" <?php echo $selected; ?>><?php echo $this->Html->safe($email); ?></option>
                            <?php } ?>
                        </select>
                        <small class="form-text text-muted"><?php $this->_('Polarismail.tab_client_lists.members_hint'); ?></small>
                    </div>
                </div>
                <div class="form-group">
                    <label for="polarismail-list-additional"><?php $this->_('Polarismail.tab_client_lists.field_additional_members'); ?></label>
                    <input
                        type="text"
                        class="form-control"
                        id="polarismail-list-additional"
                        name="additional_members"
                        value="<?php echo $this->Html->safe($get_value($add_values, 'additional_members')); ?>"
                        placeholder="user@example.com, other@example.com"
                    >
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-plus"></i>
                    <?php $this->_('Polarismail.tab_client_lists.option_add'); ?>
                </button>
                <?php $this->Form->end(); ?>
            <?php } ?>
        </div>
    </div>

    <div class="card polarismail-card">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="fas fa-address-book mr-2"></i>
                <?php $this->_('Polarismail.tab_client_lists.card_table_title'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-right">
                <?php $this->_('Polarismail.tab_client_lists.description_table'); ?>
            </span>
        </div>
        <div class="card-body">
            <?php if (!empty($lists_collection)) { ?>
            <div class="polarismail-table-wrapper">
                <table class="table table-striped table-hover table-sm">
                    <thead class="thead-light">
                        <tr>
                            <th><?php $this->_('Polarismail.tab_client_lists.field_list_name'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_lists.field_list_type'); ?></th>
                            <th class="text-center"><?php $this->_('Polarismail.tab_client_lists.field_actions'); ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($lists_collection as $list_item) {
                            $list_name = isset($list_item->lname) ? $list_item->lname : '';
                            $list_type = isset($list_item->listtype) ? $list_item->listtype : '';
                            $list_type_label = (string) $list_type === '1'
                                ? $this->_('Polarismail.tab_client_lists.list_type_distribution', true)
                                : $list_type;
                        ?>
                        <tr>
                            <td><?php $this->Html->_($list_name); ?></td>
                            <td><?php $this->Html->_($list_type_label); ?></td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-cog"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a href="#" class="dropdown-item edit-list" data-listname="<?php echo $this->Html->safe($list_name); ?>">
                                            <i class="fas fa-tools"></i> <?php $this->_('Polarismail.tab_client_lists.option_edit'); ?>
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a href="#" class="dropdown-item text-danger delete-list" data-listname="<?php echo $this->Html->safe($list_name); ?>">
                                            <i class="fas fa-trash"></i> <?php $this->_('Polarismail.tab_client_lists.option_delete'); ?>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
            <?php } else { ?>
            <div class="polarismail-empty-state">
                <?php $this->_('Polarismail.tab_client_lists.text_no_lists'); ?>
            </div>
            <?php } ?>
        </div>
    </div>
    <?php } ?>
</div>

<?php if (!$verification_required_flag) { ?>
<?php
$this->Form->create(null, ['id' => 'polarismail-list-action-form']);
$this->Form->fieldHidden('list_action', '');
$this->Form->fieldHidden('lname', '');
$this->Form->end();
?>
<?php
$this->Form->create(null, ['id' => 'polarismail-list-edit-form']);
$this->Form->fieldHidden('list_action', 'update');
$this->Form->fieldHidden('lname', $this->Html->safe($edit_list_name));
$this->Form->end();
?>

<div class="modal fade" id="polarismail-list-edit-modal" tabindex="-1" role="dialog" aria-labelledby="polarismail-list-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="polarismail-list-edit-title"><?php $this->_('Polarismail.tab_client_lists.heading_edit'); ?></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label><?php $this->_('Polarismail.tab_client_lists.field_list_name'); ?></label>
                    <input type="text" class="form-control" id="polarismail-list-edit-name" value="<?php echo $this->Html->safe($edit_list_name); ?>" readonly>
                </div>
                <div class="form-group">
                    <label><?php $this->_('Polarismail.tab_client_lists.field_members'); ?></label>
                    <div id="polarismail-list-edit-members">
                        <?php foreach ($edit_members as $member) { ?>
                            <div class="d-flex align-items-center justify-content-between border rounded px-2 py-1 mb-2" data-member="<?php echo $this->Html->safe($member); ?>">
                                <span><?php echo $this->Html->safe($member); ?></span>
                                <button type="button" class="btn btn-sm btn-outline-danger remove-list-member">
                                    <i class="fas fa-times"></i> <?php $this->_('Polarismail.tab_client_lists.option_remove'); ?>
                                </button>
                                <input type="hidden" name="members[]" form="polarismail-list-edit-form" value="<?php echo $this->Html->safe($member); ?>">
                            </div>
                        <?php } ?>
                    </div>
                    <small class="form-text text-muted"><?php $this->_('Polarismail.tab_client_lists.members_edit_hint'); ?></small>
                </div>
                <div class="form-group">
                    <label for="polarismail-list-edit-add-member"><?php $this->_('Polarismail.tab_client_lists.field_add_member'); ?></label>
                    <div class="input-group">
                        <input
                            type="email"
                            class="form-control"
                            id="polarismail-list-edit-add-member"
                            placeholder="user@example.com"
                        >
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-primary" id="polarismail-list-edit-add-button">
                                <i class="fas fa-plus"></i> <?php $this->_('Polarismail.tab_client_lists.option_add_member'); ?>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal"><?php $this->_('Polarismail.tab_client_lists.option_cancel'); ?></button>
                <button type="submit" class="btn btn-primary" form="polarismail-list-edit-form">
                    <i class="fas fa-save"></i> <?php $this->_('Polarismail.tab_client_lists.option_save'); ?>
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function() {
        var deleteConfirm = <?php echo json_encode(Language::_('Polarismail.tab_client_lists.confirm_delete', true)); ?>;
        var editModal = $('#polarismail-list-edit-modal');

        $('.delete-list').on('click', function(event) {
            event.preventDefault();
            var listName = $(this).data('listname');
            if (!listName || !confirm(deleteConfirm)) {
                return;
            }

            var form = $('#polarismail-list-action-form');
            form.find('input[name="list_action"]').val('delete');
            form.find('input[name="lname"]').val(listName);
            form.submit();
        });

        $('.edit-list').on('click', function(event) {
            event.preventDefault();
            var listName = $(this).data('listname');
            if (!listName) {
                return;
            }

            var form = $('#polarismail-list-action-form');
            form.find('input[name="list_action"]').val('edit');
            form.find('input[name="lname"]').val(listName);
            form.submit();
        });

        if (<?php echo $edit_list_name !== '' ? 'true' : 'false'; ?>) {
            editModal.modal('show');
        }

        $('#polarismail-list-edit-add-button').on('click', function() {
            var input = $('#polarismail-list-edit-add-member');
            var email = $.trim(input.val());
            if (!email) {
                return;
            }

            var existing = $('#polarismail-list-edit-members').find('[data-member="' + email.replace(/"/g, '\\"') + '"]');
            if (existing.length) {
                input.val('');
                return;
            }

            var row = $('<div class="d-flex align-items-center justify-content-between border rounded px-2 py-1 mb-2" data-member=""></div>');
            row.attr('data-member', email);
            row.append($('<span></span>').text(email));
            row.append(
                $('<button type="button" class="btn btn-sm btn-outline-danger remove-list-member"><i class="fas fa-times"></i> <?php echo $this->Html->safe($this->_('Polarismail.tab_client_lists.option_remove', true)); ?></button>')
            );
            row.append($('<input type="hidden" name="members[]" form="polarismail-list-edit-form">').val(email));
            $('#polarismail-list-edit-members').append(row);
            input.val('');
        });

        $('#polarismail-list-edit-members').on('click', '.remove-list-member', function() {
            $(this).closest('[data-member]').remove();
        });
    });
</script>
<?php } ?>
