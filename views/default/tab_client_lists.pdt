                            >
                            <span class="input-group-text">@<?php echo $this->Html->safe($service_domain_name); ?></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label for="polarismail-list-type" class="form-label"><?php $this->_('Polarismail.tab_client_lists.field_list_type'); ?></label>
                        <select class="form-select" id="polarismail-list-type" name="ltype">
                            <option value="1" selected><?php echo $this->Html->safe($this->_('Polarismail.tab_client_lists.list_type_distribution', true)); ?></option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="polarismail-list-members" class="form-label"><?php $this->_('Polarismail.tab_client_lists.field_members'); ?></label>
                        <select class="form-select" id="polarismail-list-members" name="members[]" multiple>
                            <?php foreach ($account_emails as $email) {
                                $selected = in_array($email, $get_value($add_values, 'members', []), true) ? 'selected' : '';
                            ?>
                            <option value="<?php echo $this->Html->safe($email); ?>" <?php echo $selected; ?>><?php echo $this->Html->safe($email); ?></option>
