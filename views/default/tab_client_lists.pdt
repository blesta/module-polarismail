                <div class="mb-3 mt-3">
                    <label for="polarismail-list-additional" class="form-label"><?php $this->_('Polarismail.tab_client_lists.field_additional_members'); ?></label>
                    <input
                        type="text"
                        class="form-control"
                        id="polarismail-list-additional"
                        name="additional_members"
                        value="<?php echo $this->Html->safe($get_value($add_values, 'additional_members')); ?>"
                        placeholder="user@example.com, other@example.com"
                    >
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-plus"></i>
                    <?php $this->_('Polarismail.tab_client_lists.option_add'); ?>
                </button>
                <?php $this->Form->end(); ?>
