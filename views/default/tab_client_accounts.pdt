                        <?php $this->_('Polarismail.tab_client_accounts.option_add'); ?>
                    </a>
                    <a href="#" class="btn btn-outline-primary" id="polarismail-import-account-button">
                        <i class="bi bi-file-earmark-arrow-up"></i>
                        <?php $this->_('Polarismail.tab_client_accounts.option_import'); ?>
                    </a>
                </div>
            </div>

            <?php if ($account_count > 0) { ?>
            <div class="polarismail-table-wrapper">
                <table class="table table-striped table-hover table-sm">
                    <thead class="table-light">
                        <tr>
                            <th><?php $this->_('Polarismail.tab_client_accounts.field_email'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_accounts.field_account_type'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_accounts.field_quota'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_accounts.field_usage'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_accounts.field_status'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_accounts.field_last_login'); ?></th>
                            <th class="text-center"><?php $this->_('Polarismail.tab_client_accounts.field_actions'); ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($accounts_list as $account) {
                            $account_type_value = isset($account->account_type) ? (int) $account->account_type : $default_account_type_value;
                            $account_type_label = isset($account_types_map[$account_type_value])
                                ? $account_types_map[$account_type_value]
                                : $account_types_map[$default_account_type_value];
                            $status_class = !empty($account->disabled) ? 'polarismail-status-danger' : 'polarismail-status-success';
                            $status_text = !empty($account->disabled)
                                ? Language::_('Polarismail.tab_client_accounts.status_disabled', true)
                                : Language::_('Polarismail.tab_client_accounts.status_active', true);
                            $quota_numeric = isset($account->quota) && is_numeric($account->quota)
                                ? round(((float) $account->quota) / 1000, 2)
                                : 0;
                            $quota_display = $format_metric($quota_numeric, 2);
                            $usage_display = isset($account->usage) ? $account->usage : '0';
                            $last_login = isset($account->lastauth_timestamp) ? $account->lastauth_timestamp : 'Never';
                            $username_value = isset($account->username) ? $account->username : '';
                            $email_value = isset($account->email) ? $account->email : ($username_value !== '' ? $username_value . '@' . $service_domain_name : '');
                            $display_name_value = isset($account->uname) ? $account->uname : '';
                        ?>
                        <tr
                            data-account-username="<?php echo $this->Html->safe($username_value); ?>"
                            data-account-email="<?php echo $this->Html->safe($email_value); ?>"
                            data-account-type="<?php echo (int) $account_type_value; ?>"
                            data-account-quota="<?php echo $this->Html->safe($quota_numeric); ?>"
