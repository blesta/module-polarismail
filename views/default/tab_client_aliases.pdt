<?php
include __DIR__ . DS . 'partials' . DS . 'client_styles.pdt';

$verification_required_flag = !empty($verification_required);
$pending_label = $this->_('Polarismail.verification_pending_action.aliases', true);
$pending_url = isset($pending_manage_uri) ? $pending_manage_uri : '';
$pending_target = $this->Html->safe($pending_label);
if (!empty($pending_url)) {
    $pending_target = '<a href="' . $this->Html->safe($pending_url) . '"'
        . ' class="polarismail-cta-link">'
        . $this->Html->safe($pending_label)
        . '</a>';
}
$pending_message = sprintf(
    $this->_('Polarismail.verification_pending_action', true),
    $pending_target
);

$aliases_list = [];
if (isset($aliases) && is_array($aliases)) {
    $aliases_list = $aliases;
}

$accounts_list = [];
if (isset($accounts) && is_array($accounts)) {
    $accounts_list = $accounts;
}

$service_domain_name = isset($service_domain) ? $service_domain : '';
$alias_limit_value = isset($alias_limit) ? (int) $alias_limit : 0;
$alias_count = count($aliases_list);
$limit_reached = $alias_limit_value > 0 && $alias_count >= $alias_limit_value;
$add_values = isset($add_values) && is_array($add_values) ? $add_values : [];

$get_value = function ($array, $key, $default = '') {
    return isset($array[$key]) ? $array[$key] : $default;
};

?>
<div class="polarismail-client-container polarismail-aliases">
    <?php if ($verification_required_flag) { ?>
    <div class="card polarismail-card polarismail-card-locked">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="fas fa-lock mr-2"></i>
                <?php $this->_('Polarismail.tab_client_aliases.card_manage_title'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-right">
                <?php $this->_('Polarismail.tab_client_aliases.description'); ?>
            </span>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <?php echo $pending_message; ?>
            </div>
        </div>
    </div>
    <?php } else { ?>
    <div class="card polarismail-card">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="fas fa-envelope-open-text mr-2"></i>
                <?php $this->_('Polarismail.tab_client_aliases.card_manage_title'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-right">
                <?php $this->_('Polarismail.tab_client_aliases.description'); ?>
            </span>
        </div>
        <div class="card-body polarismail-alert-spaced">
            <div class="alert alert-info">
                <?php $this->_('Polarismail.tab_client_aliases.description_manage'); ?>
            </div>
        </div>
    </div>

    

    

    <div class="card polarismail-card">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="fas fa-plus-circle mr-2"></i>
                <?php $this->_('Polarismail.tab_client_aliases.card_create_title'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-right">
                <?php $this->_('Polarismail.tab_client_aliases.description_create'); ?>
            </span>
        </div>
        <div class="card-body">
            <?php if ($limit_reached) { ?>
                <div class="alert alert-danger mb-0">
                    <?php $this->_('Polarismail.tab_client_aliases.alias_limit'); ?>
                </div>
            <?php } elseif (empty($accounts_list)) { ?>
                <div class="alert alert-warning mb-0">
                    <?php $this->_('Polarismail.tab_client_aliases.error_no_accounts'); ?>
                </div>
            <?php } else { ?>
                <?php $this->Form->create(null, ['id' => 'polarismail-alias-add-form']); ?>
                <?php $this->Form->fieldHidden('alias_action', 'add'); ?>
                <div class="form-row align-items-end">
                    <div class="form-group col-md-4">
                        <label for="polarismail-alias"><?php $this->_('Polarismail.tab_client_aliases.field_alias'); ?></label>
                        <div class="input-group">
                            <input
                                type="text"
                                class="form-control"
                                id="polarismail-alias"
                                name="alias"
                                value="<?php echo $this->Html->safe($get_value($add_values, 'alias')); ?>"
                                placeholder="alias"
                                required
                            >
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="polarismail-alias-domain"><?php $this->_('Polarismail.tab_client_aliases.field_domain'); ?></label>
                        <select class="form-control" id="polarismail-alias-domain" name="alias_domain" required>
                            <option value="<?php echo $this->Html->safe($service_domain_name); ?>" selected>
                                <?php echo $this->Html->safe($service_domain_name); ?>
                            </option>
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="polarismail-forward"><?php $this->_('Polarismail.tab_client_aliases.field_forward'); ?></label>
                        <select class="form-control" id="polarismail-forward" name="forward" required>
                            <?php foreach ($accounts_list as $account) {
                                $account_email = isset($account->email) ? $account->email : '';
                                if ($account_email === '') {
                                    continue;
                                }
                                $selected = $account_email === $get_value($add_values, 'forward') ? 'selected' : '';
                            ?>
                            <option value="<?php echo $this->Html->safe($account_email); ?>" <?php echo $selected; ?>>
                                <?php echo $this->Html->safe($account_email); ?>
                            </option>
                            <?php } ?>
                        </select>
                    </div>
                    <div class="form-group col-md-12">
                        <button type="submit" class="btn btn-success btn-block">
                            <i class="fas fa-plus"></i>
                            <?php $this->_('Polarismail.tab_client_aliases.option_add'); ?>
                        </button>
                    </div>
                </div>
                <?php $this->Form->end(); ?>
            <?php } ?>
        </div>
    </div>

    <div class="card polarismail-card">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="fas fa-layer-group mr-2"></i>
                <?php $this->_('Polarismail.tab_client_aliases.card_table_title'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-right">
                <?php $this->_('Polarismail.tab_client_aliases.description_table'); ?>
            </span>
        </div>
        <div class="card-body">
            <?php if (!empty($aliases_list)) { ?>
            <div class="polarismail-table-wrapper">
                <table class="table table-striped table-hover table-sm">
                    <thead class="thead-light">
                        <tr>
                            <th><?php $this->_('Polarismail.tab_client_aliases.field_forward'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_aliases.field_alias'); ?></th>
                            <th class="text-center"><?php $this->_('Polarismail.tab_client_aliases.field_actions'); ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($aliases_list as $alias) {
                            $forward = isset($alias->forward) ? $alias->forward : '';
                            $alias_local = isset($alias->alias) ? $alias->alias : '';
                            $alias_domain = isset($alias->domain) ? $alias->domain : '';
                            $alias_display = trim($alias_local) !== ''
                                ? $alias_local . ($alias_domain !== '' ? '@' . $alias_domain : '')
                                : '';
                        ?>
                        <tr>
                            <td><?php $this->Html->_($forward); ?></td>
                            <td><?php $this->Html->_($alias_display); ?></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger delete-alias" data-alias="<?php echo $this->Html->safe($alias_local); ?>">
                                    <i class="fas fa-trash"></i> <?php $this->_('Polarismail.tab_client_aliases.option_delete'); ?>
                                </button>
                            </td>
                        </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
            <?php } else { ?>
            <div class="polarismail-empty-state">
                <?php $this->_('Polarismail.tab_client_aliases.text_no_aliases'); ?>
            </div>
            <?php } ?>
        </div>
    </div>
    <?php } ?>
</div>

<?php if (!$verification_required_flag) { ?>
<?php
$this->Form->create(null, ['id' => 'polarismail-alias-action-form']);
$this->Form->fieldHidden('alias_action', '');
$this->Form->fieldHidden('alias', '');
$this->Form->end();
?>

<script type="text/javascript">
    $(function() {
        var deleteConfirm = <?php echo json_encode(Language::_('Polarismail.tab_client_aliases.confirm_delete', true)); ?>;

        $('.delete-alias').on('click', function(event) {
            event.preventDefault();
            var alias = $(this).data('alias');

            if (!alias || !confirm(deleteConfirm)) {
                return;
            }

            var form = $('#polarismail-alias-action-form');
            form.find('input[name="alias_action"]').val('delete');
            form.find('input[name="alias"]').val(alias);
            form.submit();
        });
    });
</script>
<?php } ?>
