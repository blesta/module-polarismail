<?php
if (!function_exists('polarismail_manage_meta_value')) {
    /**
     * Extract a meta value from a module row meta collection.
     *
     * @param mixed $meta The module row meta in object/array form
     * @param string $key The meta key to retrieve
     * @return string The meta value if available
     */
    function polarismail_manage_meta_value($meta, $key)
    {
        if (is_object($meta) && isset($meta->{$key})) {
            return (string) $meta->{$key};
        }

        if (is_array($meta) && array_key_exists($key, $meta) && !is_numeric($key)) {
            return (string) $meta[$key];
        }

        if (is_array($meta)) {
            foreach ($meta as $meta_item) {
                if (is_object($meta_item) && ($meta_item->key ?? null) === $key) {
                    return (string) ($meta_item->value ?? '');
                }

                if (is_array($meta_item) && ($meta_item['key'] ?? null) === $key) {
                    return (string) ($meta_item['value'] ?? '');
                }
            }
        }

        return '';
    }
}

$link_buttons = [
    [
        'name' => $this->_('Polarismail.add_module_row', true),
        'attributes' => [
            'href' => $this->base_uri . 'settings/company/modules/addrow/' . ($module->id ?? ''),
            'class' => 'btn btn-primary'
        ]
    ]
];

$this->Widget->clear();

if (method_exists($this->Widget, 'setLinkButtons')) {
    $this->Widget->setLinkButtons($link_buttons);
} elseif (method_exists($this->Widget, 'setButtons')) {
    $this->Widget->setButtons($link_buttons);
}

$module_name = $module->name ?? '';
$this->Html->_($module_name, true);

$widget_title = $this->_(
    'AdminCompanyModules.manage.boxtitle_manage',
    true,
    $module_name
);

$this->Widget->create($widget_title, ['id' => 'manage_polarismail']);
?>

<div class="title_row first">
    <h3><?php $this->_('Polarismail.manage.module_rows_title');?></h3>
</div>

<?php
$rows = [];

if (!empty($module_rows) && is_array($module_rows)) {
    $rows = array_values($module_rows);
}

$num_rows = count($rows);

if ($num_rows > 0) {
?>
<table class="table">
    <tr class="heading_row">
        <td><span><?php $this->_('Polarismail.manage.module_rows_heading.server_name');?></span></td>
        <td><span><?php $this->_('Polarismail.manage.module_rows_heading.username');?></span></td>
        <td class="last"><span><?php $this->_('Polarismail.manage.module_rows_heading.options');?></span></td>
    </tr>
    <?php
    for ($i = 0; $i < $num_rows; $i++) {
        $row = $rows[$i];
        $server_name = polarismail_manage_meta_value($row->meta ?? [], 'server_name');
        $username = polarismail_manage_meta_value($row->meta ?? [], 'username');
    ?>
    <tr<?php echo ($i % 2 === 1) ? ' class="odd_row"' : '';?>>
        <td><?php echo $this->Html->safe($server_name);?></td>
        <td><?php echo $this->Html->safe($username);?></td>
        <td>
            <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . ($module->id ?? '') . '/' . ($row->id ?? ''));?>"><?php $this->_('Polarismail.manage.module_rows.edit');?></a>
            <?php
            $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/');
            $this->Form->fieldHidden('id', $module->id ?? '');
            $this->Form->fieldHidden('row_id', $row->id ?? '');
            ?>
            <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/deleterow/' . ($module->id ?? '') . '/' . ($row->id ?? '') . '/');?>" class="manage" rel="<?php echo $this->Html->safe($this->_('Polarismail.manage.module_rows.confirm_delete', true));?>"><?php $this->_('Polarismail.manage.module_rows.delete');?></a>
            <?php
            $this->Form->end();
            ?>
        </td>
    </tr>
    <?php
    }
    ?>
</table>
<?php
} else {
?>
<div class="empty_section">
    <div class="empty_box">
        <?php $this->_('Polarismail.manage.module_rows_no_results');?>
    </div>
</div>
<?php
}
?>

<?php
$this->Widget->end();
?>

<script type="text/javascript">
    $(document).ready(function() {
        $('#manage_polarismail a.manage[rel]').blestaModalConfirm({
            base_url: '<?php echo $this->base_uri;?>',
            close: '<?php $this->_('AppController.modal.text_close');?>',
            submit: true
        });
    });
</script>
