            </h4>
            <span class="polarismail-card-subtitle small text-md-end">
                <?php $this->_('Polarismail.tab_client_forwards.description_table'); ?>
            </span>
        </div>
        <div class="card-body">
            <?php if (!empty($forwards_list)) { ?>
            <div class="polarismail-table-wrapper">
                <table class="table table-striped table-hover table-sm">
