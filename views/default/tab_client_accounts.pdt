<?php
include __DIR__ . DS . 'partials' . DS . 'client_styles.pdt';

$verification_required_flag = !empty($verification_required);
$pending_label = $this->_('Polarismail.verification_pending_action.accounts', true);
$pending_url = isset($pending_manage_uri) ? $pending_manage_uri : '';
$pending_target = $this->Html->safe($pending_label);
if (!empty($pending_url)) {
    $pending_target = '<a href="' . $this->Html->safe($pending_url) . '"'
        . ' class="polarismail-cta-link">'
        . $this->Html->safe($pending_label)
        . '</a>';
}
$pending_message = sprintf(
    $this->_('Polarismail.verification_pending_action', true),
    $pending_target
);

$accounts_list = [];
if (isset($accounts) && is_array($accounts)) {
    $accounts_list = $accounts;
}

$account_types_map = isset($account_types) && is_array($account_types)
    ? $account_types
    : [
        1 => Language::_('Polarismail.package_fields.account_type_basic', true),
        2 => Language::_('Polarismail.package_fields.account_type_enhanced', true)
    ];
$default_account_type_value = isset($default_account_type) ? (int) $default_account_type : 1;
$default_quota_value = isset($default_quota) ? $default_quota : '10';
$service_domain_name = isset($service_domain) ? $service_domain : '';
$csv_format_text = isset($csv_format) ? $csv_format : '';
$csv_example_text = isset($csv_example) ? $csv_example : '';

$add_values = isset($add_values) && is_array($add_values) ? $add_values : [];
$edit_values = isset($edit_values) && is_array($edit_values) ? $edit_values : [];
$show_add_modal_flag = !empty($show_add_modal);
$show_edit_modal_flag = !empty($show_edit_modal);

$account_count = count($accounts_list);
$format_metric = function ($value, $decimals = 0) {
    if ($decimals > 0) {
        $formatted = number_format((float) $value, $decimals, '.', '');
        return $formatted !== '' ? rtrim(rtrim($formatted, '0'), '.') : '0';
    }

    return number_format((int) $value);
};

$get_value = function ($array, $key, $default = '') {
    return isset($array[$key]) ? $array[$key] : $default;
};
?>
<div class="polarismail-client-container polarismail-accounts">
<?php if ($verification_required_flag) { ?>
    <div class="card polarismail-card polarismail-card-locked">
        <div class="card-header polarismail-card-header d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
            <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                <i class="bi bi-lock me-2"></i>
                <?php $this->_('Polarismail.tab_client_accounts.card_manage_title'); ?>
            </h4>
            <span class="polarismail-card-subtitle small text-md-end">
                <?php $this->_('Polarismail.tab_client_accounts.description'); ?>
            </span>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <?php echo $pending_message; ?>
            </div>
        </div>
    </div>
<?php } else { ?>
    <div class="card polarismail-card">
        <div class="card-header polarismail-card-header">
            <div class="polarismail-card-header-main">
                <h4 class="mb-2 mb-md-0 d-flex align-items-center">
                    <i class="bi bi-folder2-open me-2"></i>
                    <?php $this->_('Polarismail.tab_client_accounts.card_table_title'); ?>
                </h4>
                <span class="polarismail-card-subtitle small text-md-end">
                    <?php $this->_('Polarismail.tab_client_accounts.card_table_subtitle'); ?>
                </span>
            </div>
        </div>
        <div class="card-body">
            <?php
            // Display account limits if they are configured
            $show_limits = isset($max_basic_accounts) && isset($max_enhanced_accounts) && ($max_basic_accounts > 0 || $max_enhanced_accounts > 0);
            if ($show_limits) {
                $current_basic = isset($current_basic_accounts) ? $current_basic_accounts : 0;
                $current_enhanced = isset($current_enhanced_accounts) ? $current_enhanced_accounts : 0;
            ?>
            <div class="alert alert-info mb-3">
                <h6 class="mb-2"><i class="bi bi-info-circle"></i> Account Limits</h6>
                <div class="row">
                    <?php if ($max_basic_accounts > 0) { ?>
                    <div class="col-md-6">
                        <strong>Basic Accounts:</strong> <?php echo (int)$current_basic; ?> / <?php echo (int)$max_basic_accounts; ?>
                        <?php if ($current_basic >= $max_basic_accounts) { ?>
                            <span class="badge bg-danger ms-2">Limit Reached</span>
                        <?php } ?>
                    </div>
                    <?php } ?>
                    <?php if ($max_enhanced_accounts > 0) { ?>
                    <div class="col-md-6">
                        <strong>Enhanced Accounts:</strong> <?php echo (int)$current_enhanced; ?> / <?php echo (int)$max_enhanced_accounts; ?>
                        <?php if ($current_enhanced >= $max_enhanced_accounts) { ?>
                            <span class="badge bg-danger ms-2">Limit Reached</span>
                        <?php } ?>
                    </div>
                    <?php } ?>
                </div>
            </div>
            <?php } ?>

            <div class="polarismail-card-intro mb-3">
                <p class="mb-0 text-muted small">
                    <?php $this->_('Polarismail.tab_client_accounts.card_table_description'); ?>
                </p>
                <div class="polarismail-card-actions">
