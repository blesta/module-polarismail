<?php /** @var View $this **/ ?>
<?php
$this->Widget->clear();
$this->Form->create();
$this->Widget->create($this->_('Polarismail.add_row.box_title', true), ['id' => 'polarismail_add_row']);
?>

    <h6 class="form-section-header"><?php $this->_('Polarismail.add_row.basic_title'); ?></h6>

    <div class="mb-3">
        <label for="server_name" class="form-label"><?php $this->_('Polarismail.row_meta.server_name'); ?></label>
        <?php $this->Form->fieldText('server_name', $this->Html->ifSet($vars->server_name), [
            'id' => 'server_name',
            'class' => 'form-control',
        ]); ?>
    </div>

    <div class="mb-3">
        <label for="username" class="form-label"><?php $this->_('Polarismail.row_meta.username'); ?></label>
        <?php $this->Form->fieldText('username', $this->Html->ifSet($vars->username), [
            'id' => 'username',
            'class' => 'form-control',
        ]); ?>
    </div>

    <div class="mb-3">
        <label for="password" class="form-label"><?php $this->_('Polarismail.row_meta.password'); ?></label>
        <?php $this->Form->fieldPassword('password', [
            'id' => 'password',
            'class' => 'form-control',
            'value' => $this->Html->ifSet($vars->password),
        ]); ?>
    </div>

    <?php $this->Widget->footer(); ?>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('submit', $this->_('Polarismail.add_row.add_btn', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>

<?php $this->Widget->end(); ?>

<?php $this->Form->end();
