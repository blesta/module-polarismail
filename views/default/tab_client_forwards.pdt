<?php if (!$verification_required_flag) { ?>
<?php
$this->Form->create(null, ['id' => 'polarismail-forward-action-form']);
$this->Form->fieldHidden('forward_action', '');
$this->Form->fieldHidden('forward', '');
$this->Form->fieldHidden('account', '');
$this->Form->end();
?>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var delete_confirm = <?php echo json_encode(Language::_('Polarismail.tab_client_forwards.confirm_delete', true)); ?>;
        var action_form = document.getElementById('polarismail-forward-action-form');

        function toggleForwardType() {
            var external_group = document.getElementById('polarismail-forward-external-group');
            var internal_group = document.getElementById('polarismail-forward-internal-group');
            if (!external_group || !internal_group) {
                return;
            }

            var checked = document.querySelector('input[name="forward_type"]:checked');
            var forward_type = checked ? checked.value : '';
            if (forward_type === '2') {
                external_group.style.display = '';
                internal_group.style.display = 'none';
            } else {
                external_group.style.display = 'none';
                internal_group.style.display = '';
            }
        }

        document.querySelectorAll('input[name="forward_type"]').forEach(function(radio) {
            radio.addEventListener('change', toggleForwardType);
        });
        toggleForwardType();

        document.querySelectorAll('.delete-forward').forEach(function(button) {
            button.addEventListener('click', function(event) {
                event.preventDefault();
                var forward = this.getAttribute('data-forward');
                var account = this.getAttribute('data-account');

                if (!forward || !account || !confirm(delete_confirm)) {
                    return;
                }

                action_form.querySelector('input[name="forward_action"]').value = 'delete';
                action_form.querySelector('input[name="forward"]').value = forward;
                action_form.querySelector('input[name="account"]').value = account;
                action_form.submit();
            });
        });
    });
</script>
<?php } ?>
