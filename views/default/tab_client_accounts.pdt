<?php
include __DIR__ . DS . 'partials' . DS . 'client_styles.pdt';

$verification_required_flag = !empty($verification_required);
$pending_label = $this->_('Polarismail.verification_pending_action.accounts', true);
$pending_url = isset($pending_manage_uri) ? $pending_manage_uri : '';
$pending_target = $this->Html->safe($pending_label);
if (!empty($pending_url)) {
    $pending_target = '<a href="' . $this->Html->safe($pending_url) . '"'
        . ' class="polarismail-cta-link">'
        . $this->Html->safe($pending_label)
        . '</a>';
}
$pending_message = sprintf(
    $this->_('Polarismail.verification_pending_action', true),
    $pending_target
);

$accounts_list = [];
if (isset($accounts) && is_array($accounts)) {
    $accounts_list = $accounts;
}

$account_types_map = isset($account_types) && is_array($account_types)
    ? $account_types
    : [
        1 => Language::_('Polarismail.package_fields.account_type_basic', true),
        2 => Language::_('Polarismail.package_fields.account_type_enhanced', true)
    ];
$default_account_type_value = isset($default_account_type) ? (int) $default_account_type : 1;
$default_quota_value = isset($default_quota) ? $default_quota : '10';
$service_domain_name = isset($service_domain) ? $service_domain : '';
$csv_format_text = isset($csv_format) ? $csv_format : '';
$csv_example_text = isset($csv_example) ? $csv_example : '';

$add_values = isset($add_values) && is_array($add_values) ? $add_values : [];
$edit_values = isset($edit_values) && is_array($edit_values) ? $edit_values : [];
$show_add_modal_flag = !empty($show_add_modal);
$show_edit_modal_flag = !empty($show_edit_modal);

$account_count = count($accounts_list);
$format_metric = function ($value, $decimals = 0) {
    if ($decimals > 0) {
        $formatted = number_format((float) $value, $decimals, '.', '');
        return $formatted !== '' ? rtrim(rtrim($formatted, '0'), '.') : '0';
    }

    return number_format((int) $value);
};

$get_value = function ($array, $key, $default = '') {
    return isset($array[$key]) ? $array[$key] : $default;
};
?>
<div class="polarismail-client-container polarismail-accounts">
<?php if ($verification_required_flag) { ?>
    <div class="card polarismail-card polarismail-card-locked">
