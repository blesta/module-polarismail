                                : $list_type;
                        ?>
                        <tr>
                            <td><?php $this->Html->_($list_name); ?></td>
                            <td><?php $this->Html->_($list_type_label); ?></td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="bi bi-gear"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a href="#" class="dropdown-item edit-list" data-listname="<?php echo $this->Html->safe($list_name); ?>">
                                            <i class="bi bi-tools"></i> <?php $this->_('Polarismail.tab_client_lists.option_edit'); ?>
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a href="#" class="dropdown-item text-danger delete-list" data-listname="<?php echo $this->Html->safe($list_name); ?>">
                                            <i class="bi bi-trash"></i> <?php $this->_('Polarismail.tab_client_lists.option_delete'); ?>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
            <?php } else { ?>
            <div class="polarismail-empty-state">
                <?php $this->_('Polarismail.tab_client_lists.text_no_lists'); ?>
