                        <tr>
                            <th><?php $this->_('Polarismail.tab_client_forwards.field_account'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_forwards.field_forward'); ?></th>
                            <th><?php $this->_('Polarismail.tab_client_forwards.field_type'); ?></th>
                            <th class="text-center"><?php $this->_('Polarismail.tab_client_forwards.field_actions'); ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($forwards_list as $forward) {
                            $account_value = isset($forward->username) ? $forward->username : '';
                            $forward_value = isset($forward->forward) ? $forward->forward : '';
                            $account_display = $account_value !== '' ? $account_value . ($service_domain_name !== '' ? '@' . $service_domain_name : '') : '';
                            $forward_type_label = '';
                            if ($forward_value !== '' && $service_domain_name !== '') {
                                $forward_domain = strtolower(ltrim(strrchr($forward_value, '@'), '@'));
                                if ($forward_domain !== '' && $forward_domain === strtolower($service_domain_name)) {
                                    $forward_type_label = Language::_('Polarismail.tab_client_forwards.field_type_internal', true);
                                }
                            }
                            if ($forward_type_label === '') {
                                $forward_type_label = Language::_('Polarismail.tab_client_forwards.field_type_external', true);
                            }
                        ?>
                        <tr>
                            <td><?php $this->Html->_($account_display); ?></td>
                            <td><?php $this->Html->_($forward_value); ?></td>
                            <td><?php $this->Html->_($forward_type_label); ?></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger delete-forward" data-forward="<?php echo $this->Html->safe($forward_value); ?>" data-account="<?php echo $this->Html->safe($account_value); ?>">
                                    <i class="bi bi-trash"></i> <?php $this->_('Polarismail.tab_client_forwards.option_delete'); ?>
                                </button>
