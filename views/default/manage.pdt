<?php /** @var View $this **/ ?>
<?php
if (!function_exists('polarismail_manage_meta_value')) {
    /**
     * Extract a meta value from a module row meta collection.
     *
     * @param mixed $meta The module row meta in object/array form
     * @param string $key The meta key to retrieve
     * @return string The meta value if available
     */
    function polarismail_manage_meta_value($meta, $key)
    {
        if (is_object($meta) && isset($meta->{$key})) {
            return (string) $meta->{$key};
        }

        if (is_array($meta) && array_key_exists($key, $meta) && !is_numeric($key)) {
            return (string) $meta[$key];
        }

        if (is_array($meta)) {
            foreach ($meta as $meta_item) {
                if (is_object($meta_item) && ($meta_item->key ?? null) === $key) {
                    return (string) ($meta_item->value ?? '');
                }

                if (is_array($meta_item) && ($meta_item['key'] ?? null) === $key) {
                    return (string) ($meta_item['value'] ?? '');
                }
            }
        }

        return '';
    }
}

$link_buttons = [
    [
        'name' => $this->_('Polarismail.add_module_row', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . ($module->id ?? '')],
    ],
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setBodyWrapper(false);
$this->Widget->create(
    $this->_('AdminCompanyModules.manage.boxtitle_manage', true, isset($module->name) ? $this->Html->safe($module->name) : null),
    ['id' => 'manage_polarismail']
);
?>
<?php
$rows = (!empty($module_rows) && is_array($module_rows)) ? array_values($module_rows) : [];
$num_rows = count($rows);

if ($num_rows > 0) {
?>
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Polarismail.manage.module_rows_heading.server_name'); ?></span></th>
                <th><span><?php $this->_('Polarismail.manage.module_rows_heading.username'); ?></span></th>
                <th><span><?php $this->_('Polarismail.manage.module_rows_heading.options'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <?php
            for ($i = 0; $i < $num_rows; $i++) {
                $row = $rows[$i];
                $server_name = polarismail_manage_meta_value($row->meta ?? [], 'server_name');
                $username = polarismail_manage_meta_value($row->meta ?? [], 'username');
            ?>
            <tr>
                <td><?php echo $this->Html->safe($server_name); ?></td>
                <td><?php echo $this->Html->safe($username); ?></td>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . ($module->id ?? '') . '/' . ($row->id ?? '') . '/'); ?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('Polarismail.manage.module_rows.edit'); ?>">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <?php
                    $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                    $this->Form->fieldHidden('id', $module->id ?? '');
                    $this->Form->fieldHidden('row_id', $row->id ?? '');
                    ?>
                    <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                        data-confirm-message="<?php echo $this->Html->safe($this->_('Polarismail.manage.module_rows.confirm_delete', true)); ?>"
                        title="<?php $this->_('Polarismail.manage.module_rows.delete'); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php
                    $this->Form->end();
                    ?>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
<?php
} else {
?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-server" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('Polarismail.manage.module_rows_no_results'); ?></p>
    </div>
<?php
}

$this->Widget->end();
?>
