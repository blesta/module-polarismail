?>

<div class="modal fade" id="polarismail-list-edit-modal" tabindex="-1" role="dialog" aria-labelledby="polarismail-list-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="polarismail-list-edit-title"><?php $this->_('Polarismail.tab_client_lists.heading_edit'); ?></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label"><?php $this->_('Polarismail.tab_client_lists.field_list_name'); ?></label>
                    <input type="text" class="form-control" id="polarismail-list-edit-name" value="<?php echo $this->Html->safe($edit_list_name); ?>" readonly>
                </div>
                <div class="mb-3">
                    <label class="form-label"><?php $this->_('Polarismail.tab_client_lists.field_members'); ?></label>
                    <div id="polarismail-list-edit-members">
                        <?php foreach ($edit_members as $member) { ?>
                            <div class="d-flex align-items-center justify-content-between border rounded px-2 py-1 mb-2" data-member="<?php echo $this->Html->safe($member); ?>">
                                <span><?php echo $this->Html->safe($member); ?></span>
                                <button type="button" class="btn btn-sm btn-outline-danger remove-list-member">
                                    <i class="bi bi-x-lg"></i> <?php $this->_('Polarismail.tab_client_lists.option_remove'); ?>
                                </button>
                                <input type="hidden" name="members[]" form="polarismail-list-edit-form" value="<?php echo $this->Html->safe($member); ?>">
                            </div>
                        <?php } ?>
                    </div>
                    <small class="form-text text-muted"><?php $this->_('Polarismail.tab_client_lists.members_edit_hint'); ?></small>
                </div>
                <div class="mb-3">
                    <label for="polarismail-list-edit-add-member" class="form-label"><?php $this->_('Polarismail.tab_client_lists.field_add_member'); ?></label>
                    <div class="input-group">
                        <input
                            type="email"
                            class="form-control"
                            id="polarismail-list-edit-add-member"
                            placeholder="user@example.com"
                        >
                        <button type="button" class="btn btn-outline-primary" id="polarismail-list-edit-add-button">
                            <i class="bi bi-plus"></i> <?php $this->_('Polarismail.tab_client_lists.option_add_member'); ?>
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><?php $this->_('Polarismail.tab_client_lists.option_cancel'); ?></button>
                <button type="submit" class="btn btn-primary" form="polarismail-list-edit-form">
                    <i class="bi bi-save"></i> <?php $this->_('Polarismail.tab_client_lists.option_save'); ?>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var delete_confirm = <?php echo json_encode(Language::_('Polarismail.tab_client_lists.confirm_delete', true)); ?>;
        var edit_modal = document.getElementById('polarismail-list-edit-modal');
        var action_form = document.getElementById('polarismail-list-action-form');

        document.querySelectorAll('.delete-list').forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                var list_name = this.getAttribute('data-listname');
                if (!list_name || !confirm(delete_confirm)) {
                    return;
                }

                action_form.querySelector('input[name="list_action"]').value = 'delete';
                action_form.querySelector('input[name="lname"]').value = list_name;
                action_form.submit();
            });
        });

        document.querySelectorAll('.edit-list').forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                var list_name = this.getAttribute('data-listname');
                if (!list_name) {
                    return;
                }

                action_form.querySelector('input[name="list_action"]').value = 'edit';
                action_form.querySelector('input[name="lname"]').value = list_name;
                action_form.submit();
            });
        });

        if (edit_modal && <?php echo $edit_list_name !== '' ? 'true' : 'false'; ?>) {
            bootstrap.Modal.getOrCreateInstance(edit_modal).show();
        }

        var add_member_button = document.getElementById('polarismail-list-edit-add-button');
        var members_container = document.getElementById('polarismail-list-edit-members');

        if (add_member_button && members_container) {
            add_member_button.addEventListener('click', function() {
                var input = document.getElementById('polarismail-list-edit-add-member');
                var email = input.value.trim();
                if (!email) {
                    return;
                }

                var existing = members_container.querySelector('[data-member="' + email.replace(/"/g, '\\"') + '"]');
                if (existing) {
                    input.value = '';
                    return;
                }

                var row = document.createElement('div');
                row.className = 'd-flex align-items-center justify-content-between border rounded px-2 py-1 mb-2';
                row.setAttribute('data-member', email);

                var label = document.createElement('span');
                label.textContent = email;
                row.appendChild(label);

                var remove_button = document.createElement('button');
                remove_button.type = 'button';
                remove_button.className = 'btn btn-sm btn-outline-danger remove-list-member';
                remove_button.innerHTML = '<i class="bi bi-x-lg"></i> ';
                remove_button.appendChild(document.createTextNode(<?php echo json_encode($this->_('Polarismail.tab_client_lists.option_remove', true)); ?>));
                row.appendChild(remove_button);

                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'members[]';
                hidden.setAttribute('form', 'polarismail-list-edit-form');
                hidden.value = email;
                row.appendChild(hidden);

                members_container.appendChild(row);
                input.value = '';
            });

            members_container.addEventListener('click', function(event) {
                var remove_trigger = event.target.closest('.remove-list-member');
                if (!remove_trigger) {
                    return;
                }

                var member_row = remove_trigger.closest('[data-member]');
                if (member_row) {
                    member_row.remove();
                }
            });
        }
    });
</script>
<?php } ?>
