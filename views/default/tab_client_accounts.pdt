<script type="text/javascript">
    $(function() {
        var addModal = $('#polarismail-add-modal');
        var editModal = $('#polarismail-edit-modal');
        var deleteConfirm = <?php echo json_encode(Language::_('Polarismail.tab_client_accounts.confirm_delete', true)); ?>;
        var importModal = $('#polarismail-import-modal');

        // Password validation function
        function validatePassword(password) {
            if (password.length < 8) return false;
            if (!/[A-Z]/.test(password)) return false;
            if (!/[0-9]/.test(password)) return false;
            if (!/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)) return false;
            return true;
        }

        // Generate secure password
        function generateSecurePassword() {
            var length = 12;
            var uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            var lowercase = 'abcdefghijklmnopqrstuvwxyz';
            var numbers = '0123456789';
            var symbols = '!@#$%^&*()_+-=[]{};\':"|,.<>/?';
            var all = uppercase + lowercase + numbers + symbols;
            var password = '';

            // Ensure at least one of each required character type
            password += uppercase.charAt(Math.floor(Math.random() * uppercase.length));
            password += numbers.charAt(Math.floor(Math.random() * numbers.length));
            password += symbols.charAt(Math.floor(Math.random() * symbols.length));

            // Fill the rest randomly
            for (var i = password.length; i < length; i++) {
                password += all.charAt(Math.floor(Math.random() * all.length));
            }

            // Shuffle the password
            password = password.split('').sort(function(){return 0.5-Math.random()}).join('');

            return password;
        }

        // Generate password button click handler
        $('#polarismail-generate-password').on('click', function(event) {
            event.preventDefault();
            var password = generateSecurePassword();
            var passwordField = $('#polarismail-add-password');
            passwordField.val(password);
            passwordField.attr('type', 'text');
            $('#polarismail-toggle-password i').removeClass('fa-eye').addClass('fa-eye-slash');

            // Validate the generated password
            if (validatePassword(password)) {
                passwordField.removeClass('is-invalid').addClass('is-valid');
                $('#polarismail-password-feedback').hide();
            }
        });

        // Toggle password visibility
        $('#polarismail-toggle-password').on('click', function(event) {
            event.preventDefault();
            var passwordField = $('#polarismail-add-password');
            var icon = $(this).find('i');

            if (passwordField.attr('type') === 'password') {
                passwordField.attr('type', 'text');
                icon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passwordField.attr('type', 'password');
                icon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });

        // Password validation on input
        $('#polarismail-add-password').on('input', function() {
            var password = $(this).val();
            if (password.length === 0) {
                $(this).removeClass('is-invalid is-valid');
                $('#polarismail-password-feedback').hide();
                return;
            }

            if (validatePassword(password)) {
                $(this).removeClass('is-invalid').addClass('is-valid');
                $('#polarismail-password-feedback').hide();
            } else {
                $(this).removeClass('is-valid').addClass('is-invalid');
                $('#polarismail-password-feedback').show();
            }
        });

        // Form validation on submit
        $('#polarismail-add-form').on('submit', function(event) {
            var password = $('#polarismail-add-password').val();
            if (!validatePassword(password)) {
                event.preventDefault();
                $('#polarismail-add-password').addClass('is-invalid');
                $('#polarismail-password-feedback').show();
                return false;
            }
        });

        $('#polarismail-add-account-button').on('click', function(event) {
            event.preventDefault();
            addModal.modal('show');
        });

        $('#polarismail-import-account-button').on('click', function(event) {
            event.preventDefault();
            importModal.modal('show');
        });

        $('.edit-account').on('click', function(event) {
            event.preventDefault();
            var row = $(this).closest('tr');
            var username = row.attr('data-account-username');
            var email = row.attr('data-account-email');
            var accountType = row.attr('data-account-type');
            var quota = row.attr('data-account-quota');
            var displayName = row.attr('data-account-name');

            editModal.find('input[name="account_username"]').val(username);
            editModal.find('input[name="account_email"]').val(email);
            editModal.find('select[name="account_type"]').val(accountType);
            editModal.find('input[name="quota"]').val(quota);
            editModal.find('input[name="display_name"]').val(displayName);
            editModal.find('input[name="password"]').val('');

            editModal.modal('show');
        });

        $('.account-action-trigger').on('click', function(event) {
            event.preventDefault();
            var action = $(this).data('action');
            var username = $(this).data('username');

            if (!action || !username) {
                return;
            }

            if (action === 'delete' && !confirm(deleteConfirm)) {
                return;
            }

            var form = $('#polarismail-account-action-form');
            form.find('input[name="account_action"]').val(action);
            form.find('input[name="account_username"]').val(username);
            form.submit();
        });

        if (<?php echo $show_add_modal_flag ? 'true' : 'false'; ?>) {
            addModal.modal('show');
        }

        if (<?php echo $show_edit_modal_flag ? 'true' : 'false'; ?>) {
            editModal.modal('show');
        }

        // Toggle +/- icon for CSV instructions collapse
        $('#csv-instructions-collapse').on('show.bs.collapse', function() {
            $('#csv-instructions-icon').removeClass('fa-plus-circle').addClass('fa-minus-circle');
        }).on('hide.bs.collapse', function() {
            $('#csv-instructions-icon').removeClass('fa-minus-circle').addClass('fa-plus-circle');
        });
    });
</script>
<?php } ?>
